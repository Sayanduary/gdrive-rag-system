APP_NAME=Google Drive RAG API
APP_VERSION=1.0.0

CHROMA_DB_PATH=./data/chroma_db

# LLM Configuration (LM Studio / Ollama)
LLM_PROVIDER=lmstudio
LM_STUDIO_BASE_URL=http://lmstudio:1234
LM_STUDIO_MODEL=llama-3.2-3b-instruct
LM_STUDIO_VISION_MODEL=qwen2.5-vl-3b-instruct

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Google OAuth Credentials (Replace with your credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Local dev: http://localhost:8000/api/auth/google/callback
# Production (Render): https://gdrive-rag-system.vercel.app/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Production (Render): https://gdrive-rag-system.vercel.app
FRONTEND_URL=http://localhost:5173

SESSION_SECRET=your-random-secret-key-here

