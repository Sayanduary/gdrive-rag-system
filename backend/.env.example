# Copy this file to .env and replace every placeholder with a real value.
# Never commit .env or expose backend secrets to the frontend.

# Application
APP_NAME=Zentra
APP_VERSION=1.0.0
ENVIRONMENT=development

# Session and frontend
SESSION_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:5173
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_SECURE=false

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# PostgreSQL with the pgvector extension
DATABASE_URL=your-postgresql-connection-string

# LLM provider
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
GROQ_LLM_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Embeddings and retrieval
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
RETRIEVAL_CANDIDATES=100

# Production overrides:
# ENVIRONMENT=production
# FRONTEND_URL=https://your-frontend.example
# GOOGLE_REDIRECT_URI=https://your-frontend.example/api/auth/google/callback
# SESSION_COOKIE_SAMESITE=none
# SESSION_COOKIE_SECURE=true

# Optional local providers:
# LM_STUDIO_BASE_URL=http://localhost:1234
# LM_STUDIO_MODEL=llama-3.2-3b-instruct
# LM_STUDIO_VISION_MODEL=qwen2.5-vl-3b-instruct
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3:4b
